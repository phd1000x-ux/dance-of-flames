    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/run-benchmark.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "dance-of-flames-dragonrider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "House of the Dragon inspired third-person dragon combat browser game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
